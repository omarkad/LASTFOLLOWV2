# Optional: absolute paths on your hosting server.
# DATABASE_PATH=/data/results.db
# INSTAGRAM_COOKIES_FILE=/secrets/COOKIES_mobile.json
# Leave 0 until a real authenticated membership checker is integrated.
REQUIRE_SUBSCRIPTION=0

# Default: REST friendships (no query hash required).
INSTAGRAM_FETCH_BACKEND=friendships
# Optional legacy GraphQL mode; these are NOT verified latest hashes.
# INSTAGRAM_FOLLOWERS_HASH=c76146de99bb02f6415203be841dd25a
# INSTAGRAM_FOLLOWING_HASH=d04b0a864b4b54837c0d870b0e77e076
